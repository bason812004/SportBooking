generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  PARTNER
  ADMIN
  RECIPIENT

  @@map("user_role")
}

enum AuthProvider {
  LOCAL
  GOOGLE

  @@map("auth_provider")
}

enum AccountStatus {
  ACTIVE
  LOCKED
  INACTIVE
  BLOCKED

  @@map("account_status")
}

enum VerificationPurpose {
  REGISTER
  FORGOT_PASSWORD
  CHANGE_EMAIL

  @@map("verification_purpose")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum CourtActiveStatus {
  ACTIVE
  INACTIVE

  @@map("court_active_status")
}

enum BookingStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
  NO_SHOW

  @@map("booking_status")
}

enum PaymentStatus {
  UNPAID
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  QR_TRANSFER
  BANK_TRANSFER
  E_WALLET
  ONLINE_GATEWAY

  @@map("payment_method")
}

enum PaymentType {
  DEPOSIT
  FULL_PAYMENT
  REMAINING_PAYMENT

  @@map("payment_type")
}

enum AvailabilityBlockStatus {
  ACTIVE
  INACTIVE

  @@map("availability_block_status")
}

enum DayType {
  WEEKDAY
  WEEKEND
  HOLIDAY

  @@map("day_type")
}

enum ReviewDisplayStatus {
  VISIBLE
  HIDDEN

  @@map("review_display_status")
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED

  @@map("report_status")
}

enum DynamicPricingRuleType {
  PEAK_HOUR
  OFF_PEAK_HOUR
  WEEKEND
  HOLIDAY
  HIGH_DEMAND
  LOW_DEMAND
  CUSTOM

  @@map("dynamic_pricing_rule_type")
}

enum PriceAdjustmentType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("price_adjustment_type")
}

enum DynamicPricingRuleStatus {
  ACTIVE
  INACTIVE

  @@map("dynamic_pricing_rule_status")
}

enum DemandPredictionLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH

  @@map("demand_prediction_level")
}

enum DemandPredictionStatus {
  GENERATED
  INSUFFICIENT_DATA
  FAILED

  @@map("demand_prediction_status")
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("voucher_discount_type")
}

enum VoucherStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED

  @@map("voucher_status")
}

enum VoucherFundedBy {
  PARTNER
  PLATFORM
  SHARED

  @@map("voucher_funded_by")
}

enum UserVoucherStatus {
  CLAIMED
  USED
  EXPIRED

  @@map("user_voucher_status")
}

enum TournamentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED

  @@map("tournament_status")
}

enum TournamentRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("tournament_registration_status")
}

enum AnalyticsEventType {
  COURT_VIEWED
  COURT_SEARCHED
  BOOKING_CREATED
  BOOKING_CANCELLED
  VOUCHER_CLAIMED
  VOUCHER_APPLIED
  TOURNAMENT_VIEWED
  TOURNAMENT_REGISTERED
  DYNAMIC_PRICE_VIEWED
  DYNAMIC_PRICE_CALCULATED
  PREDICTION_VIEWED
  DEMAND_PREDICTION_GENERATED
  TOURNAMENT_CREATED

  @@map("analytics_event_type")
}

enum SettlementStatus {
  PENDING
  PROCESSING
  SETTLED
  FAILED
  CANCELLED

  @@map("settlement_status")
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
  APPROVED
  PAID
}

model User {
  id                                                                  String                   @id @default(dbgenerated("('u'::text || lpad((nextval('seq_users'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  fullName                                                            String                   @map("full_name") @db.VarChar(120)
  email                                                               String                   @unique @db.VarChar(160)
  phone                                                               String?                  @db.VarChar(30)
  passwordHash                                                        String?                  @map("password_hash")
  role                                                                UserRole                 @default(USER)
  provider                                                            AuthProvider             @default(LOCAL)
  providerId                                                          String?                  @map("provider_id") @db.VarChar(160)
  emailVerified                                                       Boolean                  @default(false) @map("email_verified")
  avatarUrl                                                           String?                  @map("avatar_url")
  status                                                              AccountStatus            @default(ACTIVE)
  createdAt                                                           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  partnerId                                                           String?                  @map("partner_id") @db.VarChar(20)
  managedCourtId                                                      String?                  @map("managed_court_id") @db.VarChar(20)
  analyticsEvents                                                     AnalyticsEvent[]
  auditLogs                                                           AuditLog[]
  blog_comments                                                       blog_comments[]
  blog_likes                                                          blog_likes[]
  blog_posts                                                          blog_posts[]
  booking_admin_actions                                               booking_admin_actions[]
  bookings                                                            Booking[]
  bookingSeries                                                       BookingSeries[]
  bookingOrders                                                       BookingOrder[]
  favorites                                                           Favorite[]
  moderation_history                                                  ModerationHistory[]
  notification_campaigns_notification_campaigns_sent_byTousers        NotificationCampaign[]   @relation("notification_campaigns_sent_byTousers")
  notification_campaigns_notification_campaigns_target_user_idTousers NotificationCampaign[]   @relation("notification_campaigns_target_user_idTousers")
  notifications                                                       Notification[]
  partnerProfile                                                      PartnerProfile?
  refreshTokens                                                       RefreshToken[]
  reports                                                             Report[]
  reviews                                                             Review[]
  team_post_members                                                   team_post_members[]
  team_post_messages                                                  team_post_messages[]
  team_recruitment_posts                                              team_recruitment_posts[]
  tournamentRegistrations                                             TournamentRegistration[]
  userVouchers                                                        UserVoucher[]
  processedWithdrawals                                                WithdrawalRequest[]      @relation("WithdrawalProcessor")
  managedCourt                                                        Court?                   @relation("CourtRecipient", fields: [managedCourtId], references: [id], onUpdate: NoAction)
  partner                                                             PartnerProfile?          @relation("PartnerRecipients", fields: [partnerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_users_email")
  @@index([provider, providerId], map: "idx_users_provider_provider_id")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@index([managedCourtId], map: "idx_users_managed_court_id")
  @@index([partnerId], map: "idx_users_partner_id")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.VarChar(20)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([tokenHash], map: "idx_refresh_tokens_token_hash")
  @@map("refresh_tokens")
}

model EmailVerificationCode {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String              @db.VarChar(160)
  fullName                String              @map("full_name") @db.VarChar(120)
  phone                   String?             @db.VarChar(30)
  passwordHash            String              @map("password_hash")
  otpHash                 String              @map("otp_hash")
  purpose                 VerificationPurpose @default(REGISTER)
  expiresAt               DateTime            @map("expires_at") @db.Timestamptz(6)
  verifiedAt              DateTime?           @map("verified_at") @db.Timestamptz(6)
  attemptCount            Int                 @default(0) @map("attempt_count")
  maxAttempts             Int                 @default(5) @map("max_attempts")
  resendCount             Int                 @default(0) @map("resend_count")
  lastSentAt              DateTime            @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  accountType             String              @default("USER") @map("account_type") @db.VarChar(20)
  businessName            String?             @map("business_name") @db.VarChar(180)
  address                 String?
  verificationDocumentUrl String?             @map("verification_document_url")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([email, purpose], map: "uq_email_verification_codes_email_purpose")
  @@index([expiresAt], map: "idx_email_verification_codes_expires_at")
  @@map("email_verification_codes")
}

model PartnerProfile {
  id                      String                  @id @default(dbgenerated("('pp'::text || lpad((nextval('seq_partner_profiles'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  userId                  String                  @unique @map("user_id") @db.VarChar(20)
  businessName            String                  @map("business_name") @db.VarChar(180)
  address                 String
  verificationDocumentUrl String?                 @map("verification_document_url")
  approvalStatus          ApprovalStatus          @default(PENDING) @map("approval_status")
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bankName                String?                 @map("bank_name") @db.VarChar(120)
  bankAccountNumber       String?                 @map("bank_account_number") @db.VarChar(60)
  bankAccountHolder       String?                 @map("bank_account_holder") @db.VarChar(160)
  taxCode                 String?                 @map("tax_code") @db.VarChar(60)
  commissionRate          Decimal?                @map("commission_rate") @db.Decimal(5, 2)
  analyticsEvents         AnalyticsEvent[]
  commissionTransactions  CommissionTransaction[]
  courts                  Court[]
  dynamicPricingRules     DynamicPricingRule[]
  notification_campaigns  NotificationCampaign[]
  payouts                 PartnerPayout[]
  wallet                  PartnerWallet?
  settlements             Settlement[]
  withdrawalRequests      WithdrawalRequest[]
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tournaments             Tournament[]
  recipients              User[]                  @relation("PartnerRecipients")
  vouchers                Voucher[]

  @@index([userId], map: "idx_partner_profiles_user_id")
  @@index([approvalStatus], map: "idx_partner_profiles_approval_status")
  @@map("partner_profiles")
}

model CourtCategory {
  id          String            @id @default(dbgenerated("('cc'::text || lpad((nextval('seq_court_categories'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  name        String            @unique @db.VarChar(100)
  slug        String            @unique @db.VarChar(120)
  description String?
  status      CourtActiveStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  courts      Court[]

  @@map("court_categories")
}

model Court {
  id                     String                   @id @default(dbgenerated("('c'::text || lpad((nextval('seq_courts'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  partnerId              String                   @map("partner_id") @db.VarChar(20)
  categoryId             String                   @map("category_id") @db.VarChar(20)
  name                   String                   @db.VarChar(180)
  slug                   String                   @unique @db.VarChar(200)
  description            String?
  address                String
  city                   String                   @db.VarChar(80)
  district               String                   @db.VarChar(80)
  ward                   String?                  @db.VarChar(80)
  latitude               Decimal?                 @db.Decimal(10, 7)
  longitude              Decimal?                 @db.Decimal(10, 7)
  openingTime            DateTime                 @map("opening_time") @db.Time(6)
  closingTime            DateTime                 @map("closing_time") @db.Time(6)
  mapUrl                 String?                  @map("map_url")
  contactPhone           String?                  @map("contact_phone") @db.VarChar(30)
  contactEmail           String?                  @map("contact_email") @db.VarChar(160)
  facebookUrl            String?                  @map("facebook_url")
  sourceUrl              String?                  @map("source_url")
  verified               Boolean                  @default(false)
  courtCount             Int                      @default(1) @map("court_count")
  priceNote              String?                  @map("price_note") @db.VarChar(120)
  goldenPriceNote        String?                  @map("golden_price_note") @db.VarChar(120)
  articleContent         String?                  @map("article_content")
  directions             String?
  surfaceInfo            String?                  @map("surface_info")
  approvalStatus         ApprovalStatus           @default(PENDING) @map("approval_status")
  activeStatus           CourtActiveStatus        @default(ACTIVE) @map("active_status")
  rejectionReason        String?                  @map("rejection_reason")
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  featured               Boolean                  @default(false)
  adminNote              String?                  @map("admin_note")
  updateRequestNote      String?                  @map("update_request_note")
  updateRequestedAt      DateTime?                @map("update_requested_at") @db.Timestamptz(6)
  deposit_percent        Decimal?                 @db.Decimal(5, 2)
  bookingSlots           BookingSlot[]
  bookings               Booking[]
  bookingSeries          BookingSeries[]
  bookingOrders          BookingOrder[]
  amenities              CourtAmenity[]
  availabilityBlocks     CourtAvailabilityBlock[]
  basePrices             CourtBasePrice[]
  images                 CourtImage[]
  prices                 CourtPrice[]
  services               CourtService[]
  surfaces               CourtSurface[]
  category               CourtCategory            @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partner                PartnerProfile           @relation(fields: [partnerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  demandFeatures         DemandFeature[]
  demandPredictions      DemandPrediction[]
  dynamicPricingRules    DynamicPricingRule[]
  favorites              Favorite[]
  reports                Report[]
  reviews                Review[]
  team_recruitment_posts team_recruitment_posts[]
  tournaments            Tournament[]
  recipients             User[]                   @relation("CourtRecipient")
  vouchers               Voucher[]

  @@index([partnerId], map: "idx_courts_partner_id")
  @@index([categoryId], map: "idx_courts_category_id")
  @@index([city], map: "idx_courts_city")
  @@index([district], map: "idx_courts_district")
  @@index([approvalStatus], map: "idx_courts_approval_status")
  @@index([activeStatus], map: "idx_courts_active_status")
  @@index([slug], map: "idx_courts_slug")
  @@index([featured], map: "idx_courts_featured")
  @@index([latitude, longitude], map: "idx_courts_lat_lng")
  @@index([categoryId, city, district, activeStatus, approvalStatus], map: "idx_courts_sport_location_status")
  @@index([updateRequestedAt(sort: Desc)], map: "idx_courts_update_requested_at")
  @@index([verified], map: "idx_courts_verified")
  @@map("courts")
}

model CourtAvailabilityBlock {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courtId        String                  @map("court_id") @db.VarChar(20)
  blockDate      DateTime                @map("block_date") @db.Date
  startTime      DateTime                @map("start_time") @db.Time(6)
  endTime        DateTime                @map("end_time") @db.Time(6)
  reason         String?
  status         AvailabilityBlockStatus @default(ACTIVE)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  courtSurfaceId String?                 @map("court_surface_id") @db.VarChar(20)
  court          Court                   @relation(fields: [courtId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  courtSurface   CourtSurface?           @relation(fields: [courtSurfaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([courtId, blockDate, startTime, endTime, status], map: "idx_court_availability_blocks_lookup")
  @@index([courtSurfaceId, blockDate, startTime, endTime, status], map: "idx_court_availability_blocks_surface")
  @@map("court_availability_blocks")
}

model CourtSurface {
  id                 String                   @id @default(dbgenerated("('csf'::text || lpad((nextval('seq_court_surfaces'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  courtId            String                   @map("court_id") @db.VarChar(20)
  code               String                   @db.VarChar(40)
  name               String                   @db.VarChar(160)
  capacity           String?                  @db.VarChar(80)
  surface            String?                  @db.VarChar(120)
  size               String?                  @db.VarChar(120)
  imageUrl           String?                  @map("image_url")
  status             CourtActiveStatus        @default(ACTIVE)
  sortOrder          Int                      @default(0) @map("sort_order")
  openingTime        DateTime?                @map("opening_time") @db.Time(6)
  closingTime        DateTime?                @map("closing_time") @db.Time(6)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  booking_slots      BookingSlot[]
  bookings           Booking[]
  bookingSeries      BookingSeries[]
  availabilityBlocks CourtAvailabilityBlock[]
  court              Court                    @relation(fields: [courtId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([courtId], map: "idx_court_surfaces_court_id")
  @@map("court_surfaces")
}

model CourtImage {
  id        String   @id @default(dbgenerated("('ci'::text || lpad((nextval('seq_court_images'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  courtId   String   @map("court_id") @db.VarChar(20)
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  publicId  String?  @map("public_id")
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("court_images")
}

model CourtAmenity {
  id        String   @id @default(dbgenerated("('ca'::text || lpad((nextval('seq_court_amenities'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  courtId   String   @map("court_id") @db.VarChar(20)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("court_amenities")
}

model CourtPrice {
  id        String   @id @default(dbgenerated("('cp'::text || lpad((nextval('seq_court_prices'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  courtId   String   @map("court_id") @db.VarChar(20)
  dayType   DayType  @map("day_type")
  startTime DateTime @map("start_time") @db.Time(6)
  endTime   DateTime @map("end_time") @db.Time(6)
  price     Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([courtId, dayType, startTime, endTime], map: "idx_court_prices_lookup")
  @@map("court_prices")
}

model CourtBasePrice {
  id        String   @id @default(dbgenerated("('cbp'::text || lpad((nextval('seq_court_base_prices'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  courtId   String   @map("court_id") @db.VarChar(20)
  dayType   DayType  @map("day_type")
  startTime DateTime @map("start_time") @db.Time(6)
  endTime   DateTime @map("end_time") @db.Time(6)
  basePrice Decimal  @map("base_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([courtId, dayType, startTime, endTime], map: "idx_court_base_prices_lookup")
  @@map("court_base_prices")
}

model DynamicPricingRule {
  id                   String                   @id @default(dbgenerated("('dr'::text || lpad((nextval('seq_dynamic_pricing_rules'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  partnerId            String                   @map("partner_id") @db.VarChar(20)
  courtId              String                   @map("court_id") @db.VarChar(20)
  name                 String                   @db.VarChar(160)
  description          String?
  ruleType             DynamicPricingRuleType   @map("rule_type")
  dayType              DayType?                 @map("day_type")
  startTime            DateTime?                @map("start_time") @db.Time(6)
  endTime              DateTime?                @map("end_time") @db.Time(6)
  priceAdjustmentType  PriceAdjustmentType      @map("price_adjustment_type")
  priceAdjustmentValue Decimal                  @map("price_adjustment_value") @db.Decimal(12, 2)
  minPrice             Decimal?                 @map("min_price") @db.Decimal(12, 2)
  maxPrice             Decimal?                 @map("max_price") @db.Decimal(12, 2)
  priority             Int                      @default(100)
  status               DynamicPricingRuleStatus @default(ACTIVE)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  court                Court                    @relation(fields: [courtId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  partner              PartnerProfile           @relation(fields: [partnerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([courtId, status, priority], map: "idx_dynamic_pricing_rules_lookup")
  @@index([partnerId], map: "idx_dynamic_pricing_rules_partner_id")
  @@map("dynamic_pricing_rules")
}

model CourtService {
  id              String            @id @default(dbgenerated("('cs'::text || lpad((nextval('seq_court_services'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  courtId         String            @map("court_id") @db.VarChar(20)
  name            String            @db.VarChar(120)
  description     String?
  price           Decimal           @db.Decimal(12, 2)
  status          CourtActiveStatus @default(ACTIVE)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingServices BookingService[]
  court           Court             @relation(fields: [courtId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("court_services")
}

model Booking {
  id                       String                  @id @default(dbgenerated("('b'::text || lpad((nextval('seq_bookings'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  bookingCode              String                  @unique @map("booking_code") @db.VarChar(30)
  userId                   String                  @map("user_id") @db.VarChar(20)
  courtId                  String                  @map("court_id") @db.VarChar(20)
  bookingDate              DateTime                @map("booking_date") @db.Date
  startTime                DateTime                @map("start_time") @db.Time(6)
  endTime                  DateTime                @map("end_time") @db.Time(6)
