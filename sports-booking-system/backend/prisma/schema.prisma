generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  PARTNER
  ADMIN

  @@map("user_role")
}

enum AuthProvider {
  LOCAL
  GOOGLE

  @@map("auth_provider")
}

enum AccountStatus {
  ACTIVE
  LOCKED
  INACTIVE
  BLOCKED

  @@map("account_status")
}

enum VerificationPurpose {
  REGISTER
  FORGOT_PASSWORD
  CHANGE_EMAIL

  @@map("verification_purpose")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum CourtActiveStatus {
  ACTIVE
  INACTIVE

  @@map("court_active_status")
}

enum BookingStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
  NO_SHOW

  @@map("booking_status")
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  QR_TRANSFER
  BANK_TRANSFER
  E_WALLET
  ONLINE_GATEWAY

  @@map("payment_method")
}

enum PaymentType {
  DEPOSIT
  FULL_PAYMENT
  REMAINING_PAYMENT

  @@map("payment_type")
}

enum AvailabilityBlockStatus {
  ACTIVE
  INACTIVE

  @@map("availability_block_status")
}

enum DayType {
  WEEKDAY
  WEEKEND
  HOLIDAY

  @@map("day_type")
}

enum ReviewDisplayStatus {
  VISIBLE
  HIDDEN

  @@map("review_display_status")
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED

  @@map("report_status")
}

enum DynamicPricingRuleType {
  PEAK_HOUR
  OFF_PEAK_HOUR
  WEEKEND
  HOLIDAY
  HIGH_DEMAND
  LOW_DEMAND
  CUSTOM

  @@map("dynamic_pricing_rule_type")
}

enum PriceAdjustmentType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("price_adjustment_type")
}

enum DynamicPricingRuleStatus {
  ACTIVE
  INACTIVE

  @@map("dynamic_pricing_rule_status")
}

enum DemandPredictionLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH

  @@map("demand_prediction_level")
}

enum DemandPredictionStatus {
  GENERATED
  INSUFFICIENT_DATA
  FAILED

  @@map("demand_prediction_status")
}

enum VoucherDiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("voucher_discount_type")
}

enum VoucherStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED

  @@map("voucher_status")
}

enum UserVoucherStatus {
  CLAIMED
  USED
  EXPIRED

  @@map("user_voucher_status")
}

enum TournamentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED

  @@map("tournament_status")
}

enum TournamentRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("tournament_registration_status")
}

enum AnalyticsEventType {
  COURT_VIEWED
  COURT_SEARCHED
  BOOKING_CREATED
  BOOKING_CANCELLED
  VOUCHER_CLAIMED
  VOUCHER_APPLIED
  TOURNAMENT_VIEWED
  TOURNAMENT_REGISTERED
  DYNAMIC_PRICE_VIEWED
  DYNAMIC_PRICE_CALCULATED
  PREDICTION_VIEWED
  DEMAND_PREDICTION_GENERATED
  TOURNAMENT_CREATED

  @@map("analytics_event_type")
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  fullName      String        @map("full_name") @db.VarChar(120)
  email         String        @unique @db.VarChar(160)
  phone         String?       @db.VarChar(30)
  passwordHash  String?       @map("password_hash")
  role          UserRole      @default(USER)
  provider      AuthProvider  @default(LOCAL)
  providerId    String?       @map("provider_id") @db.VarChar(160)
  emailVerified Boolean       @default(false) @map("email_verified")
  avatarUrl     String?       @map("avatar_url")
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  partnerProfile          PartnerProfile?
  bookings                Booking[]
  reviews                 Review[]
  reports                 Report[]
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  favorites               Favorite[]
  payments                Payment[]
  userVouchers            UserVoucher[]
  analyticsEvents         AnalyticsEvent[]
  tournamentRegistrations TournamentRegistration[]
  auditLogs               AuditLog[]

  @@index([email], map: "idx_users_email")
  @@index([provider, providerId], map: "idx_users_provider_provider_id")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([tokenHash], map: "idx_refresh_tokens_token_hash")
  @@map("refresh_tokens")
}

model EmailVerificationCode {
  id                      String              @id @default(uuid()) @db.Uuid
  email                   String              @db.VarChar(160)
  fullName                String              @map("full_name") @db.VarChar(120)
  phone                   String?             @db.VarChar(30)
  passwordHash            String              @map("password_hash")
  otpHash                 String              @map("otp_hash")
  purpose                 VerificationPurpose @default(REGISTER)
  expiresAt               DateTime            @map("expires_at") @db.Timestamptz
  verifiedAt              DateTime?           @map("verified_at") @db.Timestamptz
  attemptCount            Int                 @default(0) @map("attempt_count")
  maxAttempts             Int                 @default(5) @map("max_attempts")
  resendCount             Int                 @default(0) @map("resend_count")
  lastSentAt              DateTime            @default(now()) @map("last_sent_at") @db.Timestamptz
  accountType             String              @default("USER") @map("account_type") @db.VarChar(20)
  businessName            String?             @map("business_name") @db.VarChar(180)
  address                 String?
  verificationDocumentUrl String?             @map("verification_document_url")
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([email, purpose], map: "uq_email_verification_codes_email_purpose")
  @@index([expiresAt], map: "idx_email_verification_codes_expires_at")
  @@map("email_verification_codes")
}

model PartnerProfile {
  id                      String         @id @default(uuid()) @db.Uuid
  userId                  String         @unique @map("user_id") @db.Uuid
  businessName            String         @map("business_name") @db.VarChar(180)
  address                 String
  verificationDocumentUrl String?        @map("verification_document_url")
  approvalStatus          ApprovalStatus @default(PENDING) @map("approval_status")
  commissionRate          Decimal?       @map("commission_rate") @db.Decimal(5, 2)
  bankName                String?        @map("bank_name") @db.VarChar(120)
  bankAccountNumber       String?        @map("bank_account_number") @db.VarChar(60)
  bankAccountHolder       String?        @map("bank_account_holder") @db.VarChar(160)
  taxCode                 String?        @map("tax_code") @db.VarChar(60)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courts                 Court[]
  commissionTransactions CommissionTransaction[]
  payouts                PartnerPayout[]
  dynamicPricingRules    DynamicPricingRule[]
  vouchers               Voucher[]
  analyticsEvents        AnalyticsEvent[]
  tournaments            Tournament[]

  @@index([userId], map: "idx_partner_profiles_user_id")
  @@index([approvalStatus], map: "idx_partner_profiles_approval_status")
  @@map("partner_profiles")
}

model CourtCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique @db.VarChar(100)
  slug        String            @unique @db.VarChar(120)
  description String?
  status      CourtActiveStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  courts Court[]

  @@map("court_categories")
}

model Court {
  id                String            @id @default(uuid()) @db.Uuid
  partnerId         String            @map("partner_id") @db.Uuid
  categoryId        String            @map("category_id") @db.Uuid
  name              String            @db.VarChar(180)
  slug              String            @unique @db.VarChar(200)
  description       String?
  address           String
  city              String            @db.VarChar(80)
  district          String            @db.VarChar(80)
  ward              String?           @db.VarChar(80)
  latitude          Decimal?          @db.Decimal(10, 7)
  longitude         Decimal?          @db.Decimal(10, 7)
  openingTime       DateTime          @map("opening_time") @db.Time
  closingTime       DateTime          @map("closing_time") @db.Time
  mapUrl            String?           @map("map_url")
  contactPhone      String?           @map("contact_phone") @db.VarChar(30)
  contactEmail      String?           @map("contact_email") @db.VarChar(160)
  facebookUrl       String?           @map("facebook_url")
  sourceUrl         String?           @map("source_url")
  verified          Boolean           @default(false)
  featured          Boolean           @default(false)
  adminNote         String?           @map("admin_note")
  updateRequestNote String?           @map("update_request_note")
  updateRequestedAt DateTime?         @map("update_requested_at") @db.Timestamptz
  courtCount        Int               @default(1) @map("court_count")
  priceNote         String?           @map("price_note") @db.VarChar(120)
  goldenPriceNote   String?           @map("golden_price_note") @db.VarChar(120)
  articleContent    String?           @map("article_content")
  directions        String?
  surfaceInfo       String?           @map("surface_info")
  approvalStatus    ApprovalStatus    @default(PENDING) @map("approval_status")
  activeStatus      CourtActiveStatus @default(ACTIVE) @map("active_status")
  rejectionReason   String?           @map("rejection_reason")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  partner             PartnerProfile           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category            CourtCategory            @relation(fields: [categoryId], references: [id])
  images              CourtImage[]
  surfaces            CourtSurface[]
  amenities           CourtAmenity[]
  prices              CourtPrice[]
  services            CourtService[]
  bookings            Booking[]
  reviews             Review[]
  reports             Report[]
  availabilityBlocks  CourtAvailabilityBlock[]
  favorites           Favorite[]
  bookingSlots        BookingSlot[]
  basePrices          CourtBasePrice[]
  dynamicPricingRules DynamicPricingRule[]
  demandPredictions   DemandPrediction[]
  demandFeatures      DemandFeature[]
  vouchers            Voucher[]
  tournaments         Tournament[]

  @@index([partnerId], map: "idx_courts_partner_id")
  @@index([categoryId], map: "idx_courts_category_id")
  @@index([city], map: "idx_courts_city")
  @@index([district], map: "idx_courts_district")
  @@index([approvalStatus], map: "idx_courts_approval_status")
  @@index([activeStatus], map: "idx_courts_active_status")
  @@index([slug], map: "idx_courts_slug")
  @@map("courts")
}

model CourtAvailabilityBlock {
  id        String                  @id @default(uuid()) @db.Uuid
  courtId   String                  @map("court_id") @db.Uuid
  blockDate DateTime                @map("block_date") @db.Date
  startTime DateTime                @map("start_time") @db.Time
  endTime   DateTime                @map("end_time") @db.Time
  reason    String?
  status    AvailabilityBlockStatus @default(ACTIVE)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, blockDate, startTime, endTime, status], map: "idx_court_availability_blocks_lookup")
  @@map("court_availability_blocks")
}

model CourtSurface {
  id        String            @id @default(uuid()) @db.Uuid
  courtId   String            @map("court_id") @db.Uuid
  code      String            @db.VarChar(40)
  name      String            @db.VarChar(160)
  capacity  String?           @db.VarChar(80)
  surface   String?           @db.VarChar(120)
  size      String?           @db.VarChar(120)
  imageUrl  String?           @map("image_url")
  status    CourtActiveStatus @default(ACTIVE)
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  court        Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  bookingSlots BookingSlot[]

  @@index([courtId], map: "idx_court_surfaces_court_id")
  @@map("court_surfaces")
}

model CourtImage {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  imageUrl  String   @map("image_url")
  publicId  String?  @map("public_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_images")
}

model CourtAmenity {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_amenities")
}

model CourtPrice {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  dayType   DayType  @map("day_type")
  startTime DateTime @map("start_time") @db.Time
  endTime   DateTime @map("end_time") @db.Time
  price     Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_prices")
}

model CourtBasePrice {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  dayType   DayType  @map("day_type")
  startTime DateTime @map("start_time") @db.Time
  endTime   DateTime @map("end_time") @db.Time
  basePrice Decimal  @map("base_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, dayType, startTime, endTime], map: "idx_court_base_prices_lookup")
  @@map("court_base_prices")
}

model DynamicPricingRule {
  id                   String                   @id @default(uuid()) @db.Uuid
  partnerId            String                   @map("partner_id") @db.Uuid
  courtId              String                   @map("court_id") @db.Uuid
  name                 String                   @db.VarChar(160)
  description          String?
  ruleType             DynamicPricingRuleType   @map("rule_type")
  dayType              DayType?                 @map("day_type")
  startTime            DateTime?                @map("start_time") @db.Time
  endTime              DateTime?                @map("end_time") @db.Time
  priceAdjustmentType  PriceAdjustmentType      @map("price_adjustment_type")
  priceAdjustmentValue Decimal                  @map("price_adjustment_value") @db.Decimal(12, 2)
  minPrice             Decimal?                 @map("min_price") @db.Decimal(12, 2)
  maxPrice             Decimal?                 @map("max_price") @db.Decimal(12, 2)
  priority             Int                      @default(100)
  status               DynamicPricingRuleStatus @default(ACTIVE)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  court   Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, status, priority], map: "idx_dynamic_pricing_rules_lookup")
  @@index([partnerId], map: "idx_dynamic_pricing_rules_partner_id")
  @@map("dynamic_pricing_rules")
}

model CourtService {
  id          String            @id @default(uuid()) @db.Uuid
  courtId     String            @map("court_id") @db.Uuid
  name        String            @db.VarChar(120)
  description String?
  price       Decimal           @db.Decimal(12, 2)
  status      CourtActiveStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  court           Court            @relation(fields: [courtId], references: [id], onDelete: Cascade)
  bookingServices BookingService[]

  @@map("court_services")
}

model Booking {
  id                       String        @id @default(uuid()) @db.Uuid
  bookingCode              String        @unique @map("booking_code") @db.VarChar(30)
  userId                   String        @map("user_id") @db.Uuid
  courtId                  String        @map("court_id") @db.Uuid
  courtSurfaceId           String?       @map("court_surface_id") @db.Uuid
  bookingDate              DateTime      @map("booking_date") @db.Date
  startTime                DateTime      @map("start_time") @db.Time
  endTime                  DateTime      @map("end_time") @db.Time
  totalPrice               Decimal       @map("total_price") @db.Decimal(12, 2)
  basePrice                Decimal       @default(0) @map("base_price") @db.Decimal(12, 2)
  dynamicAdjustmentAmount  Decimal       @default(0) @map("dynamic_adjustment_amount") @db.Decimal(12, 2)
  subtotal                 Decimal       @default(0) @db.Decimal(12, 2)
  voucherDiscountAmount    Decimal       @default(0) @map("voucher_discount_amount") @db.Decimal(12, 2)
  demandPredictionSnapshot Json?         @map("demand_prediction_snapshot")
  depositAmount            Decimal       @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  refundAmount             Decimal       @default(0) @map("refund_amount") @db.Decimal(12, 2)
  platformRetainedAmount   Decimal       @default(0) @map("platform_retained_amount") @db.Decimal(12, 2)
  paymentMethod            PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus            PaymentStatus @default(UNPAID) @map("payment_status")
  bookingStatus            BookingStatus @default(PENDING) @map("booking_status")
  cancelReason             String?       @map("cancel_reason")
  note                     String?
  cancelledAt              DateTime?     @map("cancelled_at") @db.Timestamptz
  adminNote                String?       @map("admin_note")
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                   User                    @relation(fields: [userId], references: [id])
  court                  Court                   @relation(fields: [courtId], references: [id])
  courtSurface           CourtSurface?           @relation(fields: [courtSurfaceId], references: [id])
  bookingServices        BookingService[]
  bookingSlots           BookingSlot[]
  payments               Payment[]
  review                 Review?
  commissionTransactions CommissionTransaction[]
  bookingVoucher         BookingVoucher?

  @@index([userId], map: "idx_bookings_user_id")
  @@index([courtId], map: "idx_bookings_court_id")
  @@index([courtSurfaceId], map: "idx_bookings_court_surface_id")
  @@index([bookingDate], map: "idx_bookings_booking_date")
  @@index([bookingStatus], map: "idx_bookings_booking_status")
  @@index([paymentStatus], map: "idx_bookings_payment_status")
  @@index([courtId, bookingDate, startTime, endTime, bookingStatus], map: "idx_bookings_schedule_conflict")
  @@index([courtSurfaceId, bookingDate, startTime, endTime, bookingStatus], map: "idx_bookings_surface_schedule_conflict")
  @@map("bookings")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([userId, courtId])
  @@map("favorites")
}

model BookingSlot {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  courtId     String   @map("court_id") @db.Uuid
  courtSurfaceId String? @map("court_surface_id") @db.Uuid
  bookingDate DateTime @map("booking_date") @db.Date
  startTime   DateTime @map("start_time") @db.Time
  endTime     DateTime @map("end_time") @db.Time
  slotPrice   Decimal  @map("slot_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court   Court   @relation(fields: [courtId], references: [id], onDelete: Cascade)
  courtSurface CourtSurface? @relation(fields: [courtSurfaceId], references: [id])

  @@index([courtId, bookingDate, startTime, endTime], map: "idx_booking_slots_schedule")
  @@index([courtSurfaceId, bookingDate, startTime, endTime], map: "idx_booking_slots_surface_schedule")
  @@index([bookingId], map: "idx_booking_slots_booking_id")
  @@map("booking_slots")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  provider              String        @db.VarChar(60)
  paymentMethod         PaymentMethod @map("payment_method")
  paymentType           PaymentType   @map("payment_type")
  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("VND") @db.VarChar(3)
  status                PaymentStatus @default(UNPAID)
  externalOrderId       String        @unique @map("external_order_id") @db.VarChar(80)
  externalTransactionId String?       @map("external_transaction_id") @db.VarChar(120)
  qrCodeUrl             String?       @map("qr_code_url")
  qrPayload             String?       @map("qr_payload")
  paymentReference      String        @map("payment_reference") @db.VarChar(80)
  expiresAt             DateTime      @map("expires_at") @db.Timestamptz
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking      Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([bookingId], map: "idx_payments_booking_id")
  @@index([userId], map: "idx_payments_user_id")
