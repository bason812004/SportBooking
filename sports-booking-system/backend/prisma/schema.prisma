  @@index([playing_date], map: "idx_team_posts_playing_date")
  @@index([sport_type], map: "idx_team_posts_sport_type")
  @@index([status], map: "idx_team_posts_status")
  @@index([user_id], map: "idx_team_posts_user_id")
}

enum blog_post_status {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum blog_visibility {
  PUBLIC
  PRIVATE
}

enum team_recruitment_status {
  OPEN
  FULL
  CLOSED
  EXPIRED
}
