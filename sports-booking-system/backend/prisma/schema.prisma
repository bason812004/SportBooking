generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  PARTNER
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  LOCKED

  @@map("account_status")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum CourtActiveStatus {
  ACTIVE
  INACTIVE

  @@map("court_active_status")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("booking_status")
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
  MOCK_PAYMENT

  @@map("payment_method")
}

enum DayType {
  WEEKDAY
  WEEKEND
  HOLIDAY

  @@map("day_type")
}

enum ReviewDisplayStatus {
  VISIBLE
  HIDDEN

  @@map("review_display_status")
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED

  @@map("report_status")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(120)
  email        String        @unique @db.VarChar(160)
  phone        String?       @db.VarChar(30)
  passwordHash String        @map("password_hash")
  role         UserRole      @default(USER)
  avatarUrl    String?       @map("avatar_url")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  partnerProfile PartnerProfile?
  bookings       Booking[]
  reviews        Review[]
  reports        Report[]
  notifications  Notification[]

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model PartnerProfile {
  id                      String         @id @default(uuid()) @db.Uuid
  userId                  String         @unique @map("user_id") @db.Uuid
  businessName            String         @map("business_name") @db.VarChar(180)
  address                 String
  verificationDocumentUrl String?        @map("verification_document_url")
  approvalStatus          ApprovalStatus @default(PENDING) @map("approval_status")
  commissionRate          Decimal?       @map("commission_rate") @db.Decimal(5, 2)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courts                 Court[]
  commissionTransactions CommissionTransaction[]

  @@index([userId], map: "idx_partner_profiles_user_id")
  @@index([approvalStatus], map: "idx_partner_profiles_approval_status")
  @@map("partner_profiles")
}

model CourtCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique @db.VarChar(100)
  slug        String            @unique @db.VarChar(120)
  description String?
  status      CourtActiveStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  courts Court[]

  @@map("court_categories")
}

model Court {
  id              String            @id @default(uuid()) @db.Uuid
  partnerId       String            @map("partner_id") @db.Uuid
  categoryId      String            @map("category_id") @db.Uuid
  name            String            @db.VarChar(180)
  slug            String            @unique @db.VarChar(200)
  description     String?
  address         String
  city            String            @db.VarChar(80)
  district        String            @db.VarChar(80)
  ward            String?           @db.VarChar(80)
  latitude        Decimal?          @db.Decimal(10, 7)
  longitude       Decimal?          @db.Decimal(10, 7)
  openingTime     DateTime          @map("opening_time") @db.Time
  closingTime     DateTime          @map("closing_time") @db.Time
  mapUrl          String?           @map("map_url")
  contactPhone    String?           @map("contact_phone") @db.VarChar(30)
  contactEmail    String?           @map("contact_email") @db.VarChar(160)
  facebookUrl     String?           @map("facebook_url")
  sourceUrl       String?           @map("source_url")
  verified        Boolean           @default(false)
  courtCount      Int               @default(1) @map("court_count")
  priceNote       String?           @map("price_note") @db.VarChar(120)
  goldenPriceNote String?           @map("golden_price_note") @db.VarChar(120)
  articleContent  String?           @map("article_content")
  directions      String?
  surfaceInfo     String?           @map("surface_info")
  approvalStatus  ApprovalStatus    @default(PENDING) @map("approval_status")
  activeStatus    CourtActiveStatus @default(ACTIVE) @map("active_status")
  rejectionReason String?           @map("rejection_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  partner   PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  category  CourtCategory  @relation(fields: [categoryId], references: [id])
  images    CourtImage[]
  surfaces  CourtSurface[]
  amenities CourtAmenity[]
  prices    CourtPrice[]
  services  CourtService[]
  bookings  Booking[]
  reviews   Review[]
  reports   Report[]

  @@index([partnerId], map: "idx_courts_partner_id")
  @@index([categoryId], map: "idx_courts_category_id")
  @@index([city], map: "idx_courts_city")
  @@index([district], map: "idx_courts_district")
  @@index([approvalStatus], map: "idx_courts_approval_status")
  @@index([activeStatus], map: "idx_courts_active_status")
  @@index([slug], map: "idx_courts_slug")
  @@map("courts")
}

model CourtSurface {
  id        String            @id @default(uuid()) @db.Uuid
  courtId   String            @map("court_id") @db.Uuid
  code      String            @db.VarChar(40)
  name      String            @db.VarChar(160)
  capacity  String?           @db.VarChar(80)
  surface   String?           @db.VarChar(120)
  size      String?           @db.VarChar(120)
  imageUrl  String?           @map("image_url")
  status    CourtActiveStatus @default(ACTIVE)
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId], map: "idx_court_surfaces_court_id")
  @@map("court_surfaces")
}

model CourtImage {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  imageUrl  String   @map("image_url")
  publicId  String?  @map("public_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_images")
}

model CourtAmenity {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_amenities")
}

model CourtPrice {
  id        String   @id @default(uuid()) @db.Uuid
  courtId   String   @map("court_id") @db.Uuid
  dayType   DayType  @map("day_type")
  startTime DateTime @map("start_time") @db.Time
  endTime   DateTime @map("end_time") @db.Time
  price     Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@map("court_prices")
}

model CourtService {
  id          String            @id @default(uuid()) @db.Uuid
  courtId     String            @map("court_id") @db.Uuid
  name        String            @db.VarChar(120)
  description String?
  price       Decimal           @db.Decimal(12, 2)
  status      CourtActiveStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  court           Court            @relation(fields: [courtId], references: [id], onDelete: Cascade)
  bookingServices BookingService[]

  @@map("court_services")
}

model Booking {
  id                     String        @id @default(uuid()) @db.Uuid
  bookingCode            String        @unique @map("booking_code") @db.VarChar(30)
  userId                 String        @map("user_id") @db.Uuid
  courtId                String        @map("court_id") @db.Uuid
  bookingDate            DateTime      @map("booking_date") @db.Date
  startTime              DateTime      @map("start_time") @db.Time
  endTime                DateTime      @map("end_time") @db.Time
  totalPrice             Decimal       @map("total_price") @db.Decimal(12, 2)
  depositAmount          Decimal       @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  refundAmount           Decimal       @default(0) @map("refund_amount") @db.Decimal(12, 2)
  platformRetainedAmount Decimal       @default(0) @map("platform_retained_amount") @db.Decimal(12, 2)
  paymentMethod          PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus          PaymentStatus @default(UNPAID) @map("payment_status")
  bookingStatus          BookingStatus @default(PENDING) @map("booking_status")
  cancelReason           String?       @map("cancel_reason")
  cancelledAt            DateTime?     @map("cancelled_at") @db.Timestamptz
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                   User                    @relation(fields: [userId], references: [id])
  court                  Court                   @relation(fields: [courtId], references: [id])
  bookingServices        BookingService[]
  review                 Review?
  commissionTransactions CommissionTransaction[]

  @@index([userId], map: "idx_bookings_user_id")
  @@index([courtId], map: "idx_bookings_court_id")
  @@index([bookingDate], map: "idx_bookings_booking_date")
  @@index([bookingStatus], map: "idx_bookings_booking_status")
  @@index([paymentStatus], map: "idx_bookings_payment_status")
  @@index([courtId, bookingDate, startTime, endTime, bookingStatus], map: "idx_bookings_schedule_conflict")
  @@map("bookings")
}

model SystemSetting {
  key          String   @id @db.VarChar(100)
  numericValue Decimal? @map("numeric_value") @db.Decimal(12, 4)
  description  String?
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

model CommissionTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  bookingId             String   @map("booking_id") @db.Uuid
  partnerId             String   @map("partner_id") @db.Uuid
  transactionType       String   @default("EARNING") @map("transaction_type") @db.VarChar(20)
  eventType             String   @map("event_type") @db.VarChar(20)
  grossAmount           Decimal  @map("gross_amount") @db.Decimal(12, 2)
  commissionRate        Decimal  @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount      Decimal  @map("commission_amount") @db.Decimal(12, 2)
  netAmount             Decimal  @map("net_amount") @db.Decimal(12, 2)
  originalTransactionId String?  @map("original_transaction_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking             Booking                 @relation(fields: [bookingId], references: [id])
  partner             PartnerProfile          @relation(fields: [partnerId], references: [id])
  originalTransaction CommissionTransaction?  @relation("CommissionReversal", fields: [originalTransactionId], references: [id])
  reversals           CommissionTransaction[] @relation("CommissionReversal")

  @@index([bookingId], map: "idx_commission_transactions_booking_id")
  @@index([partnerId, createdAt], map: "idx_commission_transactions_partner_created_at")
  @@map("commission_transactions")
}

model BookingService {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service CourtService @relation(fields: [serviceId], references: [id])

  @@map("booking_services")
}

model Review {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  courtId       String              @map("court_id") @db.Uuid
  bookingId     String              @unique @map("booking_id") @db.Uuid
  rating        Int
  comment       String?
  displayStatus ReviewDisplayStatus @default(VISIBLE) @map("display_status")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id])
  court   Court   @relation(fields: [courtId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([courtId], map: "idx_reviews_court_id")
  @@map("reviews")
}

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  courtId     String       @map("court_id") @db.Uuid
  reason      String       @db.VarChar(160)
  description String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt  DateTime?    @map("resolved_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id])
  court Court @relation(fields: [courtId], references: [id])

  @@index([status], map: "idx_reports_status")
  @@map("reports")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(160)
  content   String
  type      String   @db.VarChar(80)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_notifications_user_id")
  @@map("notifications")
}
